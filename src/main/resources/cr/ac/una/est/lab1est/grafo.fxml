<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.lab1est.controller.GrafoController"
            styleClass="fondo">

    <top>

        <VBox spacing="10"
              styleClass="barra-superior">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <Label text="EDITOR DE GRAFOS PONDERADOS"
                   styleClass="titulo-seccion"/>

            <HBox spacing="10">

                <Button text="Agregar nodo"
                        onAction="#activarAgregarNodo"
                        styleClass="boton"/>

                <Button text="Generar matriz"
                        onAction="#generarMatriz"
                        styleClass="boton"/>

                <Button text="Limpiar"
                        onAction="#limpiarGrafo"
                        styleClass="boton"/>

            </HBox>

            <Label fx:id="lblEstado"
                   text="Presione 'Agregar nodo' para comenzar."/>

        </VBox>

    </top>

    <center>

        <Pane fx:id="panelGrafo"
              prefWidth="800"
              prefHeight="550"
              styleClass="panel-grafo"/>

    </center>

    <right>

        <VBox spacing="15"
              prefWidth="320"
              styleClass="panel-resultados">

            <padding>
                <Insets top="25"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <Label text="Resultados"
                   styleClass="titulo-pequeno"/>

            <Label text="Lista de adyacencia"
                   styleClass="subtitulo"/>

            <TextArea fx:id="txtLista"
                      editable="false"
                      prefHeight="220"
                      wrapText="true"/>

            <Label fx:id="lblBFS"
                   text="Anchura (BFS): -"
                   wrapText="true"/>

            <Label fx:id="lblDFS"
                   text="Profundidad (DFS): -"
                   wrapText="true"/>

        </VBox>

    </right>

</BorderPane>