<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.lab1est.controller.MatrizController"
            styleClass="fondo">

    <top>

        <VBox spacing="10"
              styleClass="barra-superior">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <Label text="MATRIZ DE ADYACENCIA PONDERADA"
                   styleClass="titulo-seccion"/>

            <Label text="0 = sin conexión | Valores mayores que 0 = peso"
                   styleClass="subtitulo"/>

            <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <Label text="Cantidad de nodos:"/>

                <TextField fx:id="txtCantidad"
                           promptText="Ej: 5"
                           prefWidth="100"/>

                <Button text="Generar matriz"
                        onAction="#generarMatriz"
                        styleClass="boton"/>

                <Button text="Dibujar grafo"
                        onAction="#dibujarGrafo"
                        styleClass="boton"/>

                <Button text="Calcular recorridos"
                        onAction="#generarResultados"
                        styleClass="boton"/>

            </HBox>

        </VBox>

    </top>

    <center>

        <ScrollPane fitToWidth="true"
                    fitToHeight="true">

            <content>

                <VBox alignment="CENTER"
                      spacing="20">

                    <padding>
                        <Insets top="25"
                                right="25"
                                bottom="25"
                                left="25"/>
                    </padding>

                    <Label text="Matriz editable"
                           styleClass="subtitulo"/>

                    <GridPane fx:id="gridMatriz"
                              hgap="5"
                              vgap="5"
                              alignment="CENTER"/>

                </VBox>

            </content>

        </ScrollPane>

    </center>

    <right>

        <VBox spacing="15"
              prefWidth="320"
              styleClass="panel-resultados">

            <padding>
                <Insets top="25"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <Label text="Resultados"
                   styleClass="titulo-pequeno"/>

            <Label text="Lista de adyacencia"
                   styleClass="subtitulo"/>

            <TextArea fx:id="txtLista"
                      editable="false"
                      prefHeight="220"
                      wrapText="true"/>

            <Label fx:id="lblBFS"
                   text="Anchura (BFS): -"
                   wrapText="true"/>

            <Label fx:id="lblDFS"
                   text="Profundidad (DFS): -"
                   wrapText="true"/>

        </VBox>

    </right>

</BorderPane>