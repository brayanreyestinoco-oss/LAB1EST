<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="25" styleClass="contenedor-principal" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.est.lab1est.controller.MenuController">

    <padding>
        <Insets bottom="50" left="40" right="40" top="50" />
    </padding>

    <Label styleClass="titulo" text="SISTEMA DE GRAFOS" />

    <Button onAction="#abrirMatriz" prefHeight="55" prefWidth="380" styleClass="boton-principal" text="Matriz de Adyacencia → Grafo" />

    <Button onAction="#abrirGrafo" prefHeight="55" prefWidth="380" styleClass="boton-principal" text="Dibujar Grafo → Matriz de Adyacencia" />

    <Button onAction="#cerrarPrograma" prefHeight="45" prefWidth="380" styleClass="boton-salir" text="Cerrar programa" />

</VBox>
